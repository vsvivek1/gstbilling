# Postgres (Neon on Vercel). Migrations run on every Vercel build.
DATABASE_URL=

# Signs admin sessions and bill links. 32+ random characters: openssl rand -base64 32
AUTH_SECRET=
# Password for the admin pages (/admin).
ADMIN_PASSWORD=
# This site's address, used in bill links sent by email and the API, e.g. https://bills.calecutech.com
PUBLIC_URL=

# Apps allowed to send bills: SERIES:Name:API_KEY, separated by ";".
# The series (1-3 capital letters/digits) starts every bill number: QK/26-27/000001.
# Each key can only issue bills in its own series. Keys: openssl rand -hex 24
BILLING_APPS=QK:QuizKerala:change-me-to-a-long-random-key;RC:Recallio:change-me-to-another-long-key
# Series for bills made by hand in the admin (default MN).
MANUAL_SERIES=MN

# Seller. Nothing is issued until GSTIN and address are set.
GST_GSTIN=                 # e.g. 32ABCDE1234F1Z5 (its first two digits set the seller's state)
GST_ADDRESS=               # registered address as on the GST certificate
GST_LEGAL_NAME=            # default: Calecute Technologies (OPC) Private Limited
GST_SAC=999293             # commercial training and coaching
GST_RATE_PERCENT=18
GST_INVOICE_EMAIL=info@calecutech.com

# Email (bills are emailed to buyers). Without these, emails are only logged.
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
EMAIL_FROM=                # default: Calecute Technologies <SMTP_USER>
# Or Resend instead of SMTP:
RESEND_API_KEY=

# Last bill numbers already used for a series before it moved to this service,
# so numbering continues instead of repeating (e.g. QuizKerala's own QK bills):
# SERIES_START=QK/26-27/000153
SERIES_START=
